#!/usr/bin/env bash
set -euo pipefail

session_name="${1:-asco-company}"
project_root="$(git rev-parse --show-toplevel)"
shell_command="${SHELL:-/bin/sh}"

if tmux has-session -t "$session_name" 2>/dev/null; then
    printf 'The tmux session %s already exists.\n' "$session_name" >&2
    exit 1
fi

tmux new-session -d -s "$session_name" -n company -c "$project_root" "python3 -m asco.cli run >> .asco/runner.log 2>&1 & printf 'The Asco dispatcher is running in the background. Its output is in .asco/runner.log.\n'; exec $shell_command"
runner_pane="$(tmux display-message -p -t "$session_name:0.0" '#{pane_id}')"
tui_pane="$(tmux split-window -h -P -F '#{pane_id}' -t "$runner_pane" -c "$project_root" "python3 -m asco.cli tui --tmux-session $(printf '%q' "$session_name")")"
shell_pane="$(tmux split-window -v -P -F '#{pane_id}' -t "$runner_pane" -c "$project_root" "$shell_command")"
logs_pane="$(tmux split-window -v -P -F '#{pane_id}' -t "$tui_pane" -c "$project_root" "printf 'Logs appear here when you press l in the Asco TUI.\n'; exec $shell_command")"
tmux set-option -t "$session_name" @asco_runner_pane "$runner_pane"
tmux set-option -t "$session_name" @asco_tui_pane "$tui_pane"
tmux set-option -t "$session_name" @asco_shell_pane "$shell_pane"
tmux set-option -t "$session_name" @asco_log_pane "$logs_pane"
tmux select-pane -t "$tui_pane"
tmux attach-session -t "$session_name"
